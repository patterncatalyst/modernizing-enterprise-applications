   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ROUTING AXIS \u2014 .choice() on strangler.inventory.enabled decides WHICH backend answers",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ROUTING AXIS \u2014 .choice() on strangler.inventory.enabled decides WHICH backend answers",
   "lineHeight": 1.25,
   "baseline": 11.5
  },
  {
