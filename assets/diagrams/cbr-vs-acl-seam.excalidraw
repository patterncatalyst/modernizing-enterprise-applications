   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ACL AXIS \u2014 enrich() + AggregationStrategy decide WHAT shape is safe to carry back, independent of which side answered",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
