  {
   "id": "t43890638",
   "type": "text",
   "x": 780.0,
   "y": 22,
   "width": 783.2,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
