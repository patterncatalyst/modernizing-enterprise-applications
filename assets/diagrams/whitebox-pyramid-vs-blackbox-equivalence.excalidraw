   "versionNonce": 320852867,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "same system, two kinds of test: white-box pyramid vs. black-box equivalence suite",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "same system, two kinds of test: white-box pyramid vs. black-box equivalence suite",
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
   "id": "t1286838829",
   "type": "text",
   "x": 780.0,
   "y": 46,
   "width": 561.0,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 320886098,
   "versionNonce": 1084475635,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the pyramid knows Java class names; the equivalence suite only knows baseUrl and HTTP",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the pyramid knows Java class names; the equivalence suite only knows baseUrl and HTTP",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t800817828",
   "type": "text",
   "x": 110,
   "y": 565,
   "width": 519.75,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1278260965,
   "versionNonce": 569998203,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A white-box test can't compile against code that doesn't share the monolith's class names,",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A white-box test can't compile against code that doesn't share the monolith's class names,",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t1045180275",
   "type": "text",
   "x": 110,
   "y": 581,
   "width": 508.20000000000005,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1796873627,
   "versionNonce": 1750192194,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "let alone its database rows: it proves the implementation, not the behavior, is correct.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "let alone its database rows: it proves the implementation, not the behavior, is correct.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t285499977",
   "type": "text",
   "x": 940,
   "y": 565,
   "width": 537.075,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 787394338,
   "versionNonce": 629600760,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every request targets baseUrl, not a hardcoded host: the same collection, unedited, can point",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every request targets baseUrl, not a hardcoded host: the same collection, unedited, can point",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t293573050",
   "type": "text",
   "x": 940,
   "y": 581,
   "width": 548.625,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
