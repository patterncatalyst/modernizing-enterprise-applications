   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "at the monolith today or a Quarkus service tomorrow, with not one assertion changed in between.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
