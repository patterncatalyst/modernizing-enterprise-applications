  {
   "id": "t938416106",
   "type": "text",
   "x": 780.0,
   "y": 22,
   "width": 712.8000000000001,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
