   "roundness": null,
   "seed": 151018244,
   "versionNonce": 942172748,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ch.10 \u2014 same system, two kinds of test: white-box pyramid vs. black-box equivalence suite",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ch.10 \u2014 same system, two kinds of test: white-box pyramid vs. black-box equivalence suite",
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
   "id": "t1494995549",
   "type": "text",
   "x": 780.0,
   "y": 46,
   "width": 561.0,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1391162649,
   "versionNonce": 1022349259,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the pyramid knows Java class names; the equivalence suite only knows baseUrl and HTTP",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the pyramid knows Java class names; the equivalence suite only knows baseUrl and HTTP",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t44935935",
   "type": "text",
   "x": 110,
   "y": 565,
   "width": 519.75,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 438374266,
   "versionNonce": 929984522,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A white-box test can't compile against code that doesn't share the monolith's class names,",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A white-box test can't compile against code that doesn't share the monolith's class names,",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t1459229385",
   "type": "text",
   "x": 110,
   "y": 581,
   "width": 513.975,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1453162212,
   "versionNonce": 941473594,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "let alone its database rows \u2014 it proves the implementation, not the behavior, is correct.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "let alone its database rows \u2014 it proves the implementation, not the behavior, is correct.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t1850517811",
   "type": "text",
   "x": 940,
   "y": 565,
   "width": 542.85,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1663582508,
   "versionNonce": 1279940453,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every request targets baseUrl, not a hardcoded host \u2014 the same collection, unedited, can point",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every request targets baseUrl, not a hardcoded host \u2014 the same collection, unedited, can point",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t1337564803",
