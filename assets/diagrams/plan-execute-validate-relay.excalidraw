   "versionNonce": 737329258,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The planning model plans and, later, validates adversarially; the execution model builds in between: the tier that drafted the plan is the one that checks it was executed faithfully",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The planning model plans and, later, validates adversarially; the execution model builds in between: the tier that drafted the plan is the one that checks it was executed faithfully",
   "lineHeight": 1.25,
   "baseline": 12
  },
