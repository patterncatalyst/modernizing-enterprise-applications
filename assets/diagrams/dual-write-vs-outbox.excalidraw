  {
   "id": "t132394786",
   "type": "text",
   "x": 880.0,
   "y": 651.0,
   "width": 211.75000000000003,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
