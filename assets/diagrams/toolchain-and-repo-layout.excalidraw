   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1608631077,
   "versionNonce": 1568222376,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SDKMAN-managed JDK/Maven/CLI tooling and the docker compose stack both build and back the examples/ tree checked into this repository",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SDKMAN-managed JDK/Maven/CLI tooling and the docker compose stack both build and back the examples/ tree checked into this repository",
   "lineHeight": 1.25,
   "baseline": 11.5
  },
  {
   "id": "t532326886",
   "type": "text",
   "x": 20,
   "y": 622,
   "width": 993.3000000000001,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1204162883,
   "versionNonce": 1635523315,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Required for every chapter: JDK 25 (Temurin) and Maven 3.9.x, or each project's own ./mvnw. The Quarkus CLI and Camel CLI are optional conveniences scoped to Part 5 onward.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Required for every chapter: JDK 25 (Temurin) and Maven 3.9.x, or each project's own ./mvnw. The Quarkus CLI and Camel CLI are optional conveniences scoped to Part 5 onward.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t1191429966",
   "type": "text",
   "x": 20,
   "y": 638,
   "width": 993.3000000000001,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1748917718,
   "versionNonce": 1252306143,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One engine for every path: Docker Engine runs the compose stack, Testcontainers/Dev Services and minikube, so the image tags compose.yaml pins are the ones every path runs.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One engine for every path: Docker Engine runs the compose stack, Testcontainers/Dev Services and minikube, so the image tags compose.yaml pins are the ones every path runs.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
