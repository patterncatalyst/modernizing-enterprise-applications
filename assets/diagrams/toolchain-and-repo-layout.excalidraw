  {
   "id": "t1110799007",
   "type": "text",
   "x": 750.0,
   "y": 42,
   "width": 841.225,
   "height": 14.375,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
