   "versionNonce": 1276759555,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SDKMAN-managed JDK/Maven/CLI tooling and the podman compose stack both build and back the examples/ tree checked into this repository",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SDKMAN-managed JDK/Maven/CLI tooling and the podman compose stack both build and back the examples/ tree checked into this repository",
   "lineHeight": 1.25,
   "baseline": 11.5
  },
  {
   "id": "t247048900",
   "type": "text",
   "x": 20,
   "y": 622,
   "width": 993.3000000000001,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 996539060,
   "versionNonce": 1474656641,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Required for every chapter: JDK 25 (Temurin) and Maven 3.9.x, or each project's own ./mvnw. The Quarkus CLI and Camel CLI are optional conveniences scoped to Part 5 onward.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Required for every chapter: JDK 25 (Temurin) and Maven 3.9.x, or each project's own ./mvnw. The Quarkus CLI and Camel CLI are optional conveniences scoped to Part 5 onward.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t223319910",
   "type": "text",
   "x": 20,
   "y": 638,
   "width": 1056.825,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 472022105,
   "versionNonce": 486119500,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "podman compose, not docker compose, is a fixed decision: compose.yaml pins the exact Postgres, Kafka, and Grafana LGTM image tags Quarkus Dev Services and Testcontainers expect later.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "podman compose, not docker compose, is a fixed decision: compose.yaml pins the exact Postgres, Kafka, and Grafana LGTM image tags Quarkus Dev Services and Testcontainers expect later.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
