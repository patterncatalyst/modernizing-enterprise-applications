   "versionNonce": 783206121,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SDKMAN-managed JDK/Maven/CLI tooling and the docker compose stack both build and back the examples/ tree checked into this repository",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SDKMAN-managed JDK/Maven/CLI tooling and the docker compose stack both build and back the examples/ tree checked into this repository",
   "lineHeight": 1.25,
   "baseline": 11.5
  },
  {
   "id": "t1441597441",
   "type": "text",
   "x": 20,
   "y": 622,
   "width": 814.2750000000001,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 961583972,
   "versionNonce": 1100846270,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Required everywhere: JDK 25 (Temurin) and Maven 3.9.x, or each project's own ./mvnw. The Quarkus CLI and Camel CLI are optional conveniences.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Required everywhere: JDK 25 (Temurin) and Maven 3.9.x, or each project's own ./mvnw. The Quarkus CLI and Camel CLI are optional conveniences.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t822822365",
   "type": "text",
   "x": 20,
   "y": 638,
   "width": 993.3000000000001,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 818014197,
   "versionNonce": 890337990,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One engine for every path: Docker Engine runs the compose stack, Testcontainers/Dev Services and minikube, so the image tags compose.yaml pins are the ones every path runs.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One engine for every path: Docker Engine runs the compose stack, Testcontainers/Dev Services and minikube, so the image tags compose.yaml pins are the ones every path runs.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
