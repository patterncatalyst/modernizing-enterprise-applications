   "roundness": null,
   "seed": 1237674047,
   "versionNonce": 1943824135,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Order's own extraction can't complete until each of the other five has removed one of its four outbound edges, which is why order goes last, not first.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Order's own extraction can't complete until each of the other five has removed one of its four outbound edges, which is why order goes last, not first.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
