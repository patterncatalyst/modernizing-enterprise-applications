  {
   "id": "t520657309",
   "type": "text",
   "x": 40,
   "y": 544,
   "width": 883.575,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 309797994,
   "versionNonce": 199938749,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Order's own extraction can't complete until each of the other five has removed one of its four outbound edges -- which is why order goes last, not first.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Order's own extraction can't complete until each of the other five has removed one of its four outbound edges -- which is why order goes last, not first.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
