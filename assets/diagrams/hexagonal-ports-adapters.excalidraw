  },
  {
   "id": "t1187067981",
   "type": "text",
   "x": 750.0,
   "y": 22,
   "width": 673.2,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
