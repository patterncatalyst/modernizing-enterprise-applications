   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Caveat (ch.11's own): examples/02-review-service's ReviewRepository is a concrete class, not a declared Port interface the core",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Caveat (ch.11's own): examples/02-review-service's ReviewRepository is a concrete class, not a declared Port interface the core",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t1858400329",
   "type": "text",
   "x": 40,
   "y": 564,
   "width": 739.2,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
