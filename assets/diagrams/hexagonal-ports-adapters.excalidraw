   "text": "ch.11 -- Hexagonal architecture: ports and adapters, dependencies pointing inward",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ch.11 -- Hexagonal architecture: ports and adapters, dependencies pointing inward",
   "lineHeight": 1.25,
   "baseline": 17
  },
  {
   "id": "t553403616",
   "type": "text",
   "x": 750.0,
   "y": 46,
   "width": 796.95,
   "height": 14.375,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1623282328,
   "versionNonce": 1519387935,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "driving adapters translate a protocol into an inbound-port call; driven adapters implement the outbound port the core declared",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "driving adapters translate a protocol into an inbound-port call; driven adapters implement the outbound port the core declared",
   "lineHeight": 1.25,
   "baseline": 11.5
  },
  {
   "id": "t166960925",
   "type": "text",
   "x": 750.0,
   "y": 206,
   "width": 508.20000000000005,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#2f5f3d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1637914401,
   "versionNonce": 115032103,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the core never imports a protocol -- a protocol can be swapped without the core noticing",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the core never imports a protocol -- a protocol can be swapped without the core noticing",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t10177110",
   "type": "text",
   "x": 40,
   "y": 550,
   "width": 733.4250000000001,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
