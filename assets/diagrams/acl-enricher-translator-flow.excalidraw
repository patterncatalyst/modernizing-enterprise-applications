   "roundness": null,
   "seed": 1681920036,
   "versionNonce": 898399768,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Returning the ORIGINAL exchange (not the resource exchange) from aggregate() is what keeps this a merge: headers and properties the caller already set survive; only the body changes.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Returning the ORIGINAL exchange (not the resource exchange) from aggregate() is what keeps this a merge: headers and properties the caller already set survive; only the body changes.",
   "lineHeight": 1.25,
   "baseline": 11
  },
