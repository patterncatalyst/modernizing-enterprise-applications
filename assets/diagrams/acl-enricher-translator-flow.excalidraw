  {
   "id": "t1863095862",
   "type": "text",
   "x": 50,
   "y": 540,
   "width": 1101.1000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
