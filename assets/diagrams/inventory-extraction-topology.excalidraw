   "link": null,
   "locked": false,
   "text": "The ACL: inventory.proto's wire vocabulary (stock_keeping_unit/on_hand_qty/reservation_ok) is kept distinct from the",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The ACL: inventory.proto's wire vocabulary (stock_keeping_unit/on_hand_qty/reservation_ok) is kept distinct from the",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t734334730",
   "type": "text",
   "x": 40,
   "y": 448,
   "width": 828.85,
   "height": 13.75,
