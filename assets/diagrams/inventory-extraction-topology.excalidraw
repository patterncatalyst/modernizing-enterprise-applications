   "versionNonce": 1416570567,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "CDC never sat in the checkout path -- it only ever moved data sideways to seed/sync the inventory service's own copy while the monolith was still the writer.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CDC never sat in the checkout path -- it only ever moved data sideways to seed/sync the inventory service's own copy while the monolith was still the writer.",
   "lineHeight": 1.25,
   "baseline": 11
  },
