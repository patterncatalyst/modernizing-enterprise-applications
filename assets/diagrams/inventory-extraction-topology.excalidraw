   "versionNonce": 1105890793,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ACL honesty: inventory.proto's wire vocabulary (stock_keeping_unit/on_hand_qty/reservation_ok) is deliberately distinct from the",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ACL honesty: inventory.proto's wire vocabulary (stock_keeping_unit/on_hand_qty/reservation_ok) is deliberately distinct from the",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t676448741",
   "type": "text",
   "x": 40,
   "y": 448,
   "width": 840.95,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 980591635,
   "versionNonce": 1777657734,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "monolith's internal StockDto (sku/priceCents/quantityOnHand) -- RemoteInventoryClient and InventoryGrpcServiceImpl are the ACL's two sides.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "monolith's internal StockDto (sku/priceCents/quantityOnHand) -- RemoteInventoryClient and InventoryGrpcServiceImpl are the ACL's two sides.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t951919973",
   "type": "text",
   "x": 50,
   "y": 650,
   "width": 949.85,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1312466436,
   "versionNonce": 1376101452,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "CDC never sat in the checkout path -- it only ever moved data sideways to seed/sync the inventory service's own copy while the monolith was still the writer.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CDC never sat in the checkout path -- it only ever moved data sideways to seed/sync the inventory service's own copy while the monolith was still the writer.",
   "lineHeight": 1.25,
   "baseline": 11
  },
