   "baseline": 17
  },
  {
   "id": "t1437407083",
   "type": "text",
   "x": 300,
   "y": 404,
   "width": 732.0500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
