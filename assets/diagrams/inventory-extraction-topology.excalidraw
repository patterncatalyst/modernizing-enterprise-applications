   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The checkout SEAM: gRPC Reserve atomically decrements stock in the inventory service's OWN schema; a post-reserve failure",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The checkout SEAM: gRPC Reserve atomically decrements stock in the inventory service's OWN schema; a post-reserve failure",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t678032042",
   "type": "text",
   "x": 300,
   "y": 418,
   "width": 695.75,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
