   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "(insufficient stock on a later line, a payment decline, a shipping failure) triggers the compensating gRPC Release.",
   "fontSize": 11,
