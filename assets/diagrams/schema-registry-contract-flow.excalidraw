   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The registry is both the write path's destination and the read path's lookup: consumer and producer agree only because they ask the same registry.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The registry is both the write path's destination and the read path's lookup: consumer and producer agree only because they ask the same registry.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
