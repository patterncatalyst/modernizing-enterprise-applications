   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "v2's new field carries a default, so an old reader skips it and still parses the record \u2014 backward compatible.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "v2's new field carries a default, so an old reader skips it and still parses the record \u2014 backward compatible.",
