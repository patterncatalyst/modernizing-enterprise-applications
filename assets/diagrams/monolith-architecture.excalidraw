   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMELL: OrderService#placeOrder wraps inventory + order + payment + shipment + notification in ONE @Transactional spanning five contexts (ACID -> ACD).",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SMELL: OrderService#placeOrder wraps inventory + order + payment + shipment + notification in ONE @Transactional spanning five contexts (ACID -> ACD).",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t833235432",
   "type": "text",
   "x": 40,
   "y": 588,
   "width": 1235.8500000000001,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
