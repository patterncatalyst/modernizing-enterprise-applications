   "versionNonce": 212510989,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMELL: FK joins cross bounded-context boundaries freely inside the one shared schema -- order_items->inventory_items, payments/shipments/notifications->orders, reviews->customers+inventory_items, orders->customers.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SMELL: FK joins cross bounded-context boundaries freely inside the one shared schema -- order_items->inventory_items, payments/shipments/notifications->orders, reviews->customers+inventory_items, orders->customers.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
