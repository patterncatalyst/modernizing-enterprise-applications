   "text": "SMELL[ch.22]/[ch.23]/[ch.24]: OrderService#placeOrder wraps inventory + order + payment + shipment + notification in ONE @Transactional spanning five contexts (ACID -> ACD).",
   "fontSize": 10.5,
   "fontFamily": 1,
