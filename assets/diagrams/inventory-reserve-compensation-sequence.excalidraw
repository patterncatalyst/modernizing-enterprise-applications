   "locked": false,
   "text": "Reserve/Release: the cross-seam saga-lite that replaces the in-process \"free rollback\"",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Reserve/Release: the cross-seam saga-lite that replaces the in-process \"free rollback\"",
   "lineHeight": 1.25,
   "baseline": 17
  },
  {
   "id": "t1619989164",
   "type": "text",
   "x": 40,
   "y": 262,
   "width": 865.1500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 283388079,
   "versionNonce": 292337489,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One shared database, one transaction: a payment decline unwound the inventory decrement automatically, with no application code written for it.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One shared database, one transaction: a payment decline unwound the inventory decrement automatically, with no application code written for it.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1054559022",
   "type": "text",
   "x": 40,
   "y": 380,
   "width": 780.45,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 151470020,
   "versionNonce": 115802715,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Once inventory owns its own database, that automatic rollback cannot cross the service boundary -- compensation must be explicit.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Once inventory owns its own database, that automatic rollback cannot cross the service boundary -- compensation must be explicit.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
