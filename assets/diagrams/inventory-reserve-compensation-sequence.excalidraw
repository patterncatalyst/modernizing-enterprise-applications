   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Sourced from examples/00-monolith/.../order/OrderService.java, .../inventory/RemoteInventoryClient.java, SMELLS.md (smell #3),",
   "fontSize": 10.5,
   "fontFamily": 1,
