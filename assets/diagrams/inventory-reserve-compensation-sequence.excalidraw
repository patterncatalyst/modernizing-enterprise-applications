   "versionNonce": 51106392,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Honest limitation: Release is an UNCONDITIONAL increment with no dedupe key -- a retried Release after an",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Honest limitation: Release is an UNCONDITIONAL increment with no dedupe key -- a retried Release after an",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t338283469",
