   "locked": false,
   "text": "ch.19 -- Reserve/Release: the cross-seam saga-lite that replaces the in-process \"free rollback\"",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ch.19 -- Reserve/Release: the cross-seam saga-lite that replaces the in-process \"free rollback\"",
   "lineHeight": 1.25,
   "baseline": 17
  },
  {
   "id": "t543237825",
   "type": "text",
   "x": 40,
   "y": 262,
   "width": 834.9000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 143962050,
   "versionNonce": 1683912280,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One shared database, one transaction: a payment decline unwound the inventory decrement for free, with no application code written for it.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One shared database, one transaction: a payment decline unwound the inventory decrement for free, with no application code written for it.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t429864792",
   "type": "text",
   "x": 40,
   "y": 380,
   "width": 780.45,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1298695373,
   "versionNonce": 1131565901,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Once inventory owns its own database, that automatic rollback cannot cross the service boundary -- compensation must be explicit.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Once inventory owns its own database, that automatic rollback cannot cross the service boundary -- compensation must be explicit.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t16554558",
