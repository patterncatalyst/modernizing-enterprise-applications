   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Nothing makes this compensating call happen automatically the way Postgres made the monolith's rollback automatic: a saga author writes it, names it, and tests it.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
