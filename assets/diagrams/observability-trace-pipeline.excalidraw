   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Envoy sidecar spans + app-level OTel spans both export OTLP to the same otel-lgtm collector \u2014 Tempo/Mimir/Loki store, Grafana reads",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Envoy sidecar spans + app-level OTel spans both export OTLP to the same otel-lgtm collector \u2014 Tempo/Mimir/Loki store, Grafana reads",
   "lineHeight": 1.25,
   "baseline": 11.5
  },
  {
   "id": "t1798000908",
   "type": "text",
