   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "blue = app-level OpenTelemetry span \u00b7 green = Envoy sidecar span (mesh hop) \u00b7 indent = call depth, not drawn to time scale",
