   "baseline": 16
  },
  {
   "id": "t1780775535",
   "type": "text",
   "x": 140,
   "y": 560,
   "width": 671.5500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1804358409,
   "versionNonce": 1891336059,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "System of record: the orders table. Rebuildable from order.placed only as far as the topic's retention reaches.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "System of record: the orders table. Rebuildable from order.placed only as far as the topic's retention reaches.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t650419256",
   "type": "text",
   "x": 140,
   "y": 576,
   "width": 592.9000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1319271082,
   "versionNonce": 1668824971,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Past that window, the write side's own durable storage: not the log: is what the system relies on.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Past that window, the write side's own durable storage: not the log: is what the system relies on.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1802071384",
   "type": "text",
   "x": 880,
   "y": 560,
   "width": 726.0000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1141867714,
   "versionNonce": 1426263123,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "System of record: the log itself: current state is derived, never stored directly. The log is the only copy of the fact.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "System of record: the log itself: current state is derived, never stored directly. The log is the only copy of the fact.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t891846865",
