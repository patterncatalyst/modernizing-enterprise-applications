   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The write side stays a conventional, invariant-enforcing aggregate: no event-sourcing machinery anywhere near it.",
   "fontSize": 11,
   "fontFamily": 1,
