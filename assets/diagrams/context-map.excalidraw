   "versionNonce": 1013409904,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "owned by all six contexts, because a foreign key is the cheapest way to relate two rows that happen to live in the same schema.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "owned by all six contexts, because a foreign key is the cheapest way to relate two rows that happen to live in the same schema.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
