   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Shared kernel with no edges: nobody drew a narrow, governed slice of shared model -- the whole schema is treated as commonly",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Shared kernel with no edges: nobody drew a narrow, governed slice of shared model -- the whole schema is treated as commonly",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t1576187285",
   "type": "text",
   "x": 40,
   "y": 528,
   "width": 733.4250000000001,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
