<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.patterncatalyst.monolith</groupId>
  <artifactId>monolith</artifactId>
  <version>0.1.0-r02</version>
  <packaging>jar</packaging>

  <name>Reference Monolith</name>
  <description>
    The "before" picture for Modernizing Enterprise Applications: originally a single Spring
    Boot deployable, one shared Postgres schema, one JVM, six bounded contexts (order,
    inventory, payment, shipping, notification, review). Six deliberate smells were planted
    and tagged with SMELL[ch.NN] comments; see SMELLS.md. As of order-plan.md S10 (DRQ-070)
    all six contexts have been extracted and decommissioned — this module is now a frozen,
    still-building shell with zero live bounded contexts, kept permanently in-repo as the
    behavior-equivalence suite's golden-baseline referent (DRQ-024). The complete, runnable
    "before" state (all six contexts still live) is preserved on the `reference/monolith-before`
    branch (tag `v0-monolith`); `stage/NN-*-extracted` tags step through each extraction.
  </description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- springdoc 3.x is the Spring Boot 4 line (3.1.1 builds against Boot 4.1). -->
    <springdoc.version>3.1.1</springdoc.version>
  </properties>

  <dependencies>
    <!-- Spring MVC REST surface (chosen deliberately for Quarkiverse Spring-compat bridge, DRQ-029) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- Spring Data JPA persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Bean Validation -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Spring Security, deliberately guarding Review's write endpoints via the SAME
         filter chain as everything else (SMELL[ch.15]: tangled-but-independent) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Schema migrations + deterministic seed data. Spring Boot 4 moved the
         Flyway auto-configuration into its own module: without this starter,
         flyway-core on the classpath no longer runs migrations at startup. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- OpenAPI surface; seeds the future Newman behavior-equivalence suite (S6) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Test scope -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot 4: TestRestTemplate lives in its own module and needs the
         RestTemplateBuilder from spring-boot-restclient. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x (managed by Spring Boot 4.1): artifacts are
         prefixed testcontainers-*. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- order-plan.md S10 (DRQ-070, the final decommission): the Kafka producer/
       consumer dependencies (spring-kafka/spring-kafka-test, ch.17 r04/S3) and
       the gRPC client dependencies (grpc-netty-shaded/grpc-protobuf/grpc-stub/
       org.apache.tomcat:annotations-api, r05/ch.19 S7, DRQ-039) have been
       removed along with their one and only consumer in this module: the
       transactional-outbox relay (common/outbox/OutboxRelay, a KafkaTemplate
       producer) and OrderSagaListener's @KafkaListener reactions, and
       RemoteInventoryClient's gRPC blocking stub, respectively. Nothing in
       this frozen shell talks to Kafka or gRPC anymore — see SMELLS.md and
       MonolithApplication's javadoc. -->

  <build>
    <finalName>monolith</finalName>
    <!-- order-plan.md S10: the os-maven-plugin extension and the
         protobuf-maven-plugin execution that used to compile
         src/main/proto/.../inventory.proto into InventoryGrpcServiceGrpc's
         blocking-stub client classes (r05/ch.19 S7, DRQ-039) have been
         removed along with the .proto file itself and its one consumer,
         RemoteInventoryClient (deleted — see SMELLS.md). There is no more
         gRPC code generation anywhere in this frozen shell. -->
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Surefire (Tier 1 unit + Tier 2 slice tests, *Test) keeps its default
           include pattern (**/*Test.java) and already naturally excludes *IT.java
           since that pattern doesn't match. It runs in the default `test` phase. -->

      <!-- Failsafe (Tier 3 integration tests, *IT) — Testcontainers-backed
           @DataJpaTest repository tests; bound to integration-test + verify so
           `mvn verify` fails the build on a red integration test, matching the
           Surefire failure behavior for unit/slice tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
