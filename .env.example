# .env.example — tracked template for compose.yaml's image-tag pins.
#
# `.env` itself is gitignored (no secrets committed — see root .gitignore).
# Copy this file to `.env` before running the stack:
#
#   cp .env.example .env
#   podman compose --env-file .env up -d
#
# Image tags are pinned ONCE here per build-plan.md §H and decisions.md's
# version matrix ("Postgres / Kafka / Apicurio pinned once in .env to match
# Quarkus Dev Services"). The exact Quarkus version is pinned later (S4/S8,
# via quarkus-agent) — when it lands, reconcile these tags against whatever
# Quarkus Dev Services pulls by default for Postgres/Kafka so dev and the
# extracted services see identical infra versions (inherited wire-compat
# gotcha, R5/R11 in build-plan.md §M). Revisit at S14 (reconcile).

# ─── Grafana LGTM observability stack (Loki + Grafana + Tempo + Mimir) ─────
# + embedded OpenTelemetry Collector (config replaced by infra/otelcol/config.yaml)
LGTM_IMAGE_TAG=0.8.1

# ─── Postgres — the monolith's database (examples/00-monolith owns schema) ─
POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_DB=monolith
POSTGRES_USER=monolith
POSTGRES_PASSWORD=monolith_dev_only
POSTGRES_PORT=5432

# ─── Kafka (KRaft mode, single broker) ─────────────────────────────────────
KAFKA_IMAGE_TAG=3.8.0
KAFKA_HOST_PORT=9092
# Any base64-ish string works; only change this if you destroy kafka-data
# and need a fresh cluster identity (see known-issues.md "Kafka KRaft
# cluster ID").
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ─── Kafka Connect + Debezium Postgres CDC connector (r05/ch.19 step S3) ───
# debezium/connect:3.0.0.Final — current maintained "Final" tag, built on a
# Kafka Connect runtime compatible with the Kafka 3.8.0 broker pinned above.
CONNECT_IMAGE_TAG=3.0.0.Final
# Host port for the Connect REST API. Deliberately NOT 8083 — that's where
# examples/03-notification-service's Quarkus HTTP listener binds locally
# (see examples/03-notification-service/src/main/resources/application.properties).
# Inside the compose network the container still answers on :8083
# (http://connect:8083); only the host-side mapping moves.
CONNECT_HOST_PORT=8086
