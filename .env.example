# .env.example — tracked template for compose.yaml's image-tag pins.
#
# `.env` itself is gitignored (no secrets committed — see root .gitignore).
# Copy this file to `.env` before running the stack:
#
#   cp .env.example .env
#   docker compose --env-file .env up -d
#
# 2026-10-09 (DRQ-085): every tag below is the newest stable release,
# checked upstream (skopeo list-tags) that day. See _plans/decisions.md.
#
# Image tags are pinned ONCE here per build-plan.md §H and decisions.md's
# version matrix ("Postgres / Kafka / Apicurio pinned once in .env to match
# Quarkus Dev Services"). The exact Quarkus version is pinned later (S4/S8,
# via quarkus-agent) — when it lands, reconcile these tags against whatever
# Quarkus Dev Services pulls by default for Postgres/Kafka so dev and the
# extracted services see identical infra versions (inherited wire-compat
# gotcha, R5/R11 in build-plan.md §M). Revisit at S14 (reconcile).

# ─── Grafana LGTM observability stack (Loki + Grafana + Tempo + Mimir) ─────
# + embedded OpenTelemetry Collector (config replaced by infra/otelcol/config.yaml)
LGTM_IMAGE_TAG=0.36.0
# Host port for Prometheus (query + OTLP metrics ingest). Not 9090: Cockpit
# owns 9090 on Fedora Server and RHEL. Container port stays 9090.
PROMETHEUS_HOST_PORT=19090

# ─── Postgres — shared server; each extracted service owns its own schema ──
# order-plan.md S10 (DRQ-070): originally "the monolith's database"
# (examples/00-monolith owned the public schema). The monolith is now fully
# decommissioned and frozen in-repo (not part of the running topology); each
# of the six extracted services owns its own schema within this same
# database/server (e.g. examples/07-order-service's `order_service` schema).
POSTGRES_IMAGE_TAG=18.6-alpine
POSTGRES_DB=monolith
POSTGRES_USER=monolith
POSTGRES_PASSWORD=monolith_dev_only
POSTGRES_PORT=5432

# ─── Kafka (KRaft mode, single broker) ─────────────────────────────────────
# apache/kafka (the JVM image), not apache/kafka-native: the demos and
# scripts/verify-cdc.sh exec /opt/kafka/bin/*.sh inside the container, and
# kafka-native ships no CLI tools.
KAFKA_IMAGE_TAG=4.3.1
KAFKA_HOST_PORT=9092
# Any base64-ish string works; only change this if you destroy kafka-data
# and need a fresh cluster identity (see known-issues.md "Kafka KRaft
# cluster ID").
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ─── Kafka Connect + Debezium Postgres CDC connector (r05/ch.19 step S3) ───
# quay.io/debezium/connect:3.7.0.Final — newest Final; its Kafka Connect
# runtime is Kafka 4.3.1, the same as the broker pinned above. (Docker Hub's
# debezium/connect stops at 3.0.0.Final; the image now lives on quay.io.)
CONNECT_IMAGE_TAG=3.7.0.Final
# Host port for the Connect REST API. Deliberately NOT 8083 — that's where
# examples/03-notification-service's Quarkus HTTP listener binds locally
# (see examples/03-notification-service/src/main/resources/application.properties).
# Inside the compose network the container still answers on :8083
# (http://connect:8083); only the host-side mapping moves.
CONNECT_HOST_PORT=8086

# ─── Apicurio Schema Registry (ch.28, DRQ-038 follow-up/DRQ-076) ───────────
# Used ONLY by examples/09-schema-registry-demo (see compose.yaml's header
# note) — no other service in this stack depends on it. 3.3.3 is the newest
# stable server; it serves the same /apis/registry/v3 API as the 3.1.7 v3
# client pulled transitively by that module's quarkus-apicurio-registry-avro
# dependency (quarkus-bom 3.40.1). Its health endpoint moved to the
# management port 9000 (see compose.yaml's healthcheck).
APICURIO_IMAGE_TAG=3.3.3
APICURIO_HOST_PORT=8095
