{
  "info": {
    "name": "Modernizing Enterprise Applications — Behavior-Equivalence Suite",
    "_postman_id": "mea-equivalence-suite",
    "description": "The behavior-equivalence suite (r02-plan S6, build-plan.md §G/§D). Captured against the running Spring Boot monolith (examples/00-monolith). This collection is the project's equivalence gate: it is re-run UNCHANGED against each extracted service (starting with the Quarkus Review service, ch.15) and a service is only considered 'done' once it passes this same suite with no edits (build-plan.md §G load-bearing rule). Every request targets {{baseUrl}} so the identical collection can point at the monolith or at an extracted service's own port. Covers: (1) happy-path checkout, (2) out-of-stock, (3) payment-declined (asserting inventory is NOT left decremented, per the monolith's actual rollback behavior), and (4) the Review context contract (list, get-by-id, unauthenticated POST -> 401, authenticated POST -> 201, validation -> 400) — the first extraction's externally-observable surface.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "Service is reachable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inventory list returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Seed inventory includes SKU-WIDGET-001 and SKU-GIZMO-003', function () {",
                  "    var skus = pm.response.json().map(function (i) { return i.sku; });",
                  "    pm.expect(skus).to.include('SKU-WIDGET-001');",
                  "    pm.expect(skus).to.include('SKU-GIZMO-003');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Scenario 1 — Happy-Path Checkout",
      "item": [
        {
          "name": "1a. Capture stock before checkout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/SKU-WIDGET-001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "SKU-WIDGET-001"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock lookup returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('widgetStockBeforeHappyPath', json.quantityOnHand);",
                  "pm.test('Stock on hand is a non-negative number', function () {",
                  "    pm.expect(json.quantityOnHand).to.be.a('number');",
                  "    pm.expect(json.quantityOnHand).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1b. Place order -> 201 Created, CONFIRMED",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [ { \"sku\": \"SKU-WIDGET-001\", \"quantity\": 1 } ],\n  \"paymentMethod\": \"CARD-VISA\",\n  \"shippingAddress\": \"1 Equivalence Suite Way, Testville\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order created returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Location header present', function () {",
                  "    pm.expect(pm.response.headers.has('Location')).to.be.true;",
                  "});",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('happyPathOrderId', json.id);",
                  "pm.test('Order status transitions straight to CONFIRMED', function () {",
                  "    pm.expect(json.status).to.eql('CONFIRMED');",
                  "});",
                  "pm.test('Order total matches one widget unit price (1999 cents)', function () {",
                  "    pm.expect(json.totalCents).to.eql(1999);",
                  "});",
                  "pm.test('Order items echo the checkout line', function () {",
                  "    pm.expect(json.items).to.have.lengthOf(1);",
                  "    pm.expect(json.items[0].sku).to.eql('SKU-WIDGET-001');",
                  "    pm.expect(json.items[0].quantity).to.eql(1);",
                  "    pm.expect(json.items[0].unitPriceCents).to.eql(1999);",
                  "});",
                  "pm.test('Order id is a number', function () {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1c. Get the order back by id -> 200, CONFIRMED",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{happyPathOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{happyPathOrderId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order lookup returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Persisted order status is CONFIRMED', function () {",
                  "    pm.expect(json.status).to.eql('CONFIRMED');",
                  "});",
                  "pm.test('Persisted order id matches the created id', function () {",
                  "    pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('happyPathOrderId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1d. Stock decremented by exactly the ordered quantity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/SKU-WIDGET-001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "SKU-WIDGET-001"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock lookup returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var before = pm.collectionVariables.get('widgetStockBeforeHappyPath');",
                  "pm.test('Quantity on hand dropped by exactly 1 (the observable side effect of a successful checkout)', function () {",
                  "    pm.expect(json.quantityOnHand).to.eql(before - 1);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Scenario 2 — Out-of-Stock",
      "item": [
        {
          "name": "2a. Capture stock before over-ordering",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/SKU-GIZMO-003",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "SKU-GIZMO-003"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock lookup returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('gizmoStockBeforeOverorder', json.quantityOnHand);"
                ]
              }
            }
          ]
        },
        {
          "name": "2b. Order quantity exceeding stock -> 409 CONFLICT, OUT_OF_STOCK",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [ { \"sku\": \"SKU-GIZMO-003\", \"quantity\": 999999 } ],\n  \"paymentMethod\": \"CARD-VISA\",\n  \"shippingAddress\": \"1 Equivalence Suite Way, Testville\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Out-of-stock order returns 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Documented error contract: error=OUT_OF_STOCK', function () {",
                  "    pm.expect(json.error).to.eql('OUT_OF_STOCK');",
                  "});",
                  "pm.test('Error body names the offending SKU', function () {",
                  "    pm.expect(json.message).to.include('SKU-GIZMO-003');",
                  "});",
                  "pm.test('Error body carries a timestamp', function () {",
                  "    pm.expect(json.timestamp).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2c. Stock left untouched by the rejected order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/SKU-GIZMO-003",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "SKU-GIZMO-003"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock lookup returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var before = Number(pm.collectionVariables.get('gizmoStockBeforeOverorder'));",
                  "pm.test('Quantity on hand is unchanged (reservation is rejected before any write)', function () {",
                  "    pm.expect(json.quantityOnHand).to.eql(before);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Scenario 3 — Payment-Declined",
      "item": [
        {
          "name": "3a. Capture stock before the declined checkout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/SKU-WIDGET-001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "SKU-WIDGET-001"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock lookup returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('widgetStockBeforeDecline', json.quantityOnHand);"
                ]
              }
            }
          ]
        },
        {
          "name": "3b. Checkout with a DECLINE payment method -> 402, PAYMENT_DECLINED",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [ { \"sku\": \"SKU-WIDGET-001\", \"quantity\": 1 } ],\n  \"paymentMethod\": \"CARD-DECLINE\",\n  \"shippingAddress\": \"1 Equivalence Suite Way, Testville\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Declined payment returns 402 Payment Required', function () {",
                  "    pm.response.to.have.status(402);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Documented error contract: error=PAYMENT_DECLINED', function () {",
                  "    pm.expect(json.error).to.eql('PAYMENT_DECLINED');",
                  "});",
                  "pm.test('Error body mentions the declined payment method', function () {",
                  "    pm.expect(json.message).to.include('CARD-DECLINE');",
                  "});",
                  "pm.test('Error body carries a timestamp', function () {",
                  "    pm.expect(json.timestamp).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3c. Inventory is NOT left decremented after the decline",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/SKU-WIDGET-001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "SKU-WIDGET-001"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock lookup returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var before = Number(pm.collectionVariables.get('widgetStockBeforeDecline'));",
                  "pm.test('Quantity on hand is unchanged — the reservation rolled back with the declined payment (same ACID transaction, SMELL[ch.22])', function () {",
                  "    pm.expect(json.quantityOnHand).to.eql(before);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Review Context Contract",
      "item": [
        {
          "name": "4a. List reviews by sku -> 200, array",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reviews?sku=SKU-WIDGET-001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"],
              "query": [ { "key": "sku", "value": "SKU-WIDGET-001" } ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List reviews returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Response is a non-empty array of reviews for this sku', function () {",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.at.least(1);",
                  "});",
                  "pm.test('Each review has the documented shape', function () {",
                  "    json.forEach(function (r) {",
                  "        pm.expect(r).to.have.property('id');",
                  "        pm.expect(r).to.have.property('customerId');",
                  "        pm.expect(r.sku).to.eql('SKU-WIDGET-001');",
                  "        pm.expect(r.rating).to.be.within(1, 5);",
                  "        pm.expect(r).to.have.property('comment');",
                  "        pm.expect(r).to.have.property('createdAt');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4b. Get seeded review by id -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reviews/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get review by id returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Review id matches the requested id', function () {",
                  "    pm.expect(json.id).to.eql(1);",
                  "});",
                  "pm.test('Review has the documented fields', function () {",
                  "    pm.expect(json).to.have.property('customerId');",
                  "    pm.expect(json).to.have.property('sku');",
                  "    pm.expect(json.rating).to.be.within(1, 5);",
                  "    pm.expect(json).to.have.property('createdAt');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4c. Unauthenticated write is rejected -> 401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"sku\": \"SKU-WIDGET-001\",\n  \"rating\": 5,\n  \"comment\": \"equivalence suite: unauthenticated attempt\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated review write is rejected with 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4d. Authenticated write succeeds -> 201 Created",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{reviewUsername}}" },
                { "key": "password", "value": "{{reviewPassword}}" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"sku\": \"SKU-WIDGET-001\",\n  \"rating\": 5,\n  \"comment\": \"equivalence suite: authenticated write\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated review write returns 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Location header present', function () {",
                  "    pm.expect(pm.response.headers.has('Location')).to.be.true;",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Created review echoes the submitted fields', function () {",
                  "    pm.expect(json.customerId).to.eql(1);",
                  "    pm.expect(json.sku).to.eql('SKU-WIDGET-001');",
                  "    pm.expect(json.rating).to.eql(5);",
                  "    pm.expect(json.comment).to.eql('equivalence suite: authenticated write');",
                  "});",
                  "pm.test('Created review has an id and createdAt', function () {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.createdAt).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4e. Authenticated write with invalid rating -> 400 validation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{reviewUsername}}" },
                { "key": "password", "value": "{{reviewPassword}}" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"sku\": \"SKU-WIDGET-001\",\n  \"rating\": 6,\n  \"comment\": \"equivalence suite: invalid rating\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid rating returns 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Documented error contract: error=VALIDATION_FAILED', function () {",
                  "    pm.expect(json.error).to.eql('VALIDATION_FAILED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "reviewUsername", "value": "demo-customer", "type": "string" },
    { "key": "reviewPassword", "value": "demo-pass", "type": "string" },
    { "key": "happyPathOrderId", "value": "", "type": "string" },
    { "key": "widgetStockBeforeHappyPath", "value": "", "type": "string" },
    { "key": "gizmoStockBeforeOverorder", "value": "", "type": "string" },
    { "key": "widgetStockBeforeDecline", "value": "", "type": "string" }
  ]
}
